# ───────────────────────────── Core ─────────────────────────────
APP_NAME=Mochi
DATABASE_URL=sqlite:///./crm.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crm
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Origens CORS permitidas (separadas por vírgula, sem espaços).
# Inclui o frontend (5173), o gateway/testes e a PÁGINA DE EXEMPLO DO WIDGET (8080/5174).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080,http://localhost:5174

# ───────────────────────────── WhatsApp (gateway) ─────────────────────────────
GATEWAY_URL=http://localhost:3001
# AUTH: o gateway exige X-API-Key nas rotas /send* (mesmo valor no .env do gateway)
GATEWAY_API_KEY=
# AUTH: o backend exige X-Webhook-Secret no POST /api/webhook (mesmo valor no .env do gateway)
WEBHOOK_SECRET=
# Onde o gateway deve enviar as mensagens recebidas. O atendimento interno foi
# substituído pelo bot em backend/bot (porta 8001) — aponte para ele.
WHATSAPP_WEBHOOK_URL=http://localhost:8001/webhook
WHATSAPP_BOT_NAME=Assistente
# Inicia o gateway automaticamente junto com o backend (requer Node.js instalado)
AUTO_START_GATEWAY=false
# Caminho relativo ao diretório do backend para a pasta do gateway
GATEWAY_PATH=../gateway
# Inicia o bot WhatsApp (backend/bot) automaticamente junto com o backend
# (requer as deps do bot no mesmo venv e o gateway já configurado).
AUTO_START_BOT=false
# Caminho relativo ao diretório do backend para a pasta do bot
BOT_PATH=bot
# Porta em que o bot escuta (o gateway deve apontar para ela em WEBHOOK_URL)
BOT_PORT=8001
BOT_URL=http://localhost:8001

# Whitelist e grupos do bot (precedem o banco/dashboard). Quando definidas aqui,
# são repassadas ao bot automaticamente. Comente para usar o valor do banco.
# WHITELIST_ENABLED=true
# WHITELIST=5511982553849,116578431590552
# GROUP_ENABLED=true

# ───────────────────────────── Frontend ─────────────────────────────
FRONTEND_URL=http://localhost:5173

# ───────────────────────────── E-mail (Google Apps Script) ─────────────────────────────
# O envio de e-mail (tickets, reset de senha e formulário do widget) é SEMPRE via
# Google Apps Script: o backend faz POST JSON {to, subject, html, fromName?} para a URL
# abaixo. Se estiverem vazias, o envio é ignorado silenciosamente (apenas log).
EMAIL_GOOGLE_SCRIPT_URL=
EMAIL_GOOGLE_SCRIPT_SECRET=
EMAIL_FROM_NAME=Mochi

# ───────────────────────────── Taky (integração de tarefas) ─────────────────────────────
TAKY_API_URL=
TAKY_EMAIL=
TAKY_PASSWORD=
TAKY_DEFAULT_PROJECT_ID=
TAKY_DEFAULT_USER_ID=

# ───────────────────────────── LLM (provedores de IA) ─────────────────────────────
# Selecione o provedor com LLM_PROVIDER: groq | openai | anthropic | gemini | ollama
LLM_PROVIDER=groq

# Groq (compatível OpenAI)
API_GROQ=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_PRIMARY_MODEL=groq/compound-mini
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b

# OpenAI (compatível OpenAI)
API_OPENAI=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini

# Anthropic (Claude)
API_ANTHROPIC=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Google Gemini
API_GEMINI=
GEMINI_MODEL=gemini-1.5-flash

# Ollama (local, compatível OpenAI)
API_OLLAMA=
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3

# Comum a todos os provedores
GROQ_MAX_RETRIES=3
GROQ_TEMPERATURE=0.8

# ───────────────────────────── Uploads / polling ─────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=15
EMAIL_POLL_SECONDS=60

# ───────────────────────────── n8n (servidores MCP) ─────────────────────────────
# Conexão global com a instância n8n que hospeda os workflows expostos como MCP.
# Cada servidor MCP no CRM aponta para um workflow n8n com o nó "MCP Server Trigger".
# Se não informada aqui, pode ser definida por servidor no próprio cadastro.
N8N_BASE_URL=
N8N_API_KEY=