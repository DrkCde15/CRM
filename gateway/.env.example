PORT=3001
# URL do backend do CRM (deve apontar para /api/webhook)
WEBHOOK_URL=http://localhost:8000/api/webhook
# Secret compartilhado com o backend (mesmo valor do WEBHOOK_SECRET no .env do backend)
WEBHOOK_SECRET=
# API key exigida pelo gateway nas rotas /send* (mesmo valor do GATEWAY_API_KEY no .env do backend)
GATEWAY_API_KEY=
# Id da empresa (tenant) para marcar os clientes criados a partir do WhatsApp
TENANT_ID=1
LOG_LEVEL=info
